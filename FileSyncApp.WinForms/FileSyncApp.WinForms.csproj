<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <ApplicationManifest>Properties\app.manifest</ApplicationManifest>

    <!-- Product identity -->
    <AssemblyName>FileSyncApp</AssemblyName>
    <RootNamespace>FileSyncApp.WinForms</RootNamespace>
    <Product>AWS S3 File Sync</Product>
    <Company>gagneet</Company>
    <Copyright>Copyright © 2025</Copyright>
    <Description>Bidirectional file sync between local folders and AWS S3</Description>

    <!-- Version — overridable at publish time: dotnet publish -p:Version=1.2.3 -->
    <Version>1.0.0</Version>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <FileVersion>1.0.0.0</FileVersion>

    <!-- DPI awareness — handled by .NET runtime (do NOT also set in app.manifest) -->
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Krypton.Toolkit" Version="100.26.1.19" />
    <PackageReference Include="Meziantou.Framework.Win32.CredentialManager" Version="1.7.17" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="9.0.14" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="9.0.14" />
    <PackageReference Include="Serilog.Sinks.File" Version="7.0.0" />
    <PackageReference Include="Serilog.Sinks.Console" Version="6.1.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\FileSyncApp.Core\FileSyncApp.Core.csproj" />
    <ProjectReference Include="..\FileSyncApp.S3\FileSyncApp.S3.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Update="appsettings.json">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
